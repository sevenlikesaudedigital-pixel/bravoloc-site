# Copie este arquivo para .env e preencha com os valores reais (não versionados).
# Backend de rastreio de leads (Google Apps Script) — ver docs/leads-tracking.md.

# URL de implantação do Apps Script ("App para a Web"), conta SevenLike.
PUBLIC_LEADS_ENDPOINT=

# Chave simples anti-spam comparada no doPost() do Apps Script.
# Não é uma senha de verdade — troque quando quiser, só precisa bater com o
# valor de SECRET no código do Apps Script.
PUBLIC_LEADS_SECRET=
