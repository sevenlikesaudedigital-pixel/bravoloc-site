---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import ogSource from '../assets/images/hero-tenda-piramidal.jpg';

interface Props {
  title: string;
  description: string;
  preloadImages?: { href: string; media?: string }[];
}

const { title, description, preloadImages } = Astro.props;

// Backend de rastreio de leads (Google Apps Script, ver docs/leads-tracking.md).
// Recebe nome/whatsapp + palavra-chave/gclid capturados do Google Ads e grava numa planilha.
// Valores reais em .env (não versionado) — ver .env.example.
const LEADS_ENDPOINT = import.meta.env.PUBLIC_LEADS_ENDPOINT ?? '';
const LEADS_SECRET = import.meta.env.PUBLIC_LEADS_SECRET ?? '';

const SITE_URL = 'https://www.bravoloctendas.com.br';
const canonicalURL = new URL(Astro.url.pathname, SITE_URL);

const ogImage = await getImage({ src: ogSource, width: 1200, height: 630, quality: 78, format: 'jpg' });
const ogImageURL = new URL(ogImage.src, SITE_URL);

// Address confirmed against the live Google Business Profile (matches it exactly) — resolves
// the earlier conflict between the chat-given address and the approved-copy PDF. No email in
// this schema (not confirmed in the briefing).
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'BravoLoc',
  legalName: 'BravoLoc Comércio de Tendas LTDA',
  image: ogImageURL.toString(),
  url: SITE_URL,
  telephone: '+5585986560309',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Júlio Rocha, 388 — Araturi',
    addressLocality: 'Caucaia',
    addressRegion: 'CE',
    postalCode: '61655-490',
    addressCountry: 'BR',
  },
  areaServed: ['Fortaleza', 'Caucaia', 'Aquiraz', 'Eusébio', 'Ceará', 'Brasil'],
  priceRange: '$$',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '08:00',
      closes: '15:00',
    },
  ],
  // Confirmed against the live Google Business Profile (5,0 · 17 avaliações).
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '17',
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {preloadImages?.map((img) => (
      <link rel="preload" as="image" href={img.href} media={img.media} fetchpriority="high" />
    ))}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F97300" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="BravoLoc" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-WTKBQTWX');
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WTKBQTWX"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <script>
      // Reveal-on-scroll: staggers by position among reveal-marked siblings, not a global
      // index, so a card grid / numbered list stays in sync without cross-section drift.
      const revealEls = document.querySelectorAll('.reveal, .reveal-mask, .reveal-line, .reveal-rise');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if ('IntersectionObserver' in window && revealEls.length && !reduceMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                (entry.target as HTMLElement).classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => {
          const target = el as HTMLElement;
          const siblings = Array.from(target.parentElement?.children ?? []).filter((c) =>
            c.classList.contains('reveal') || c.classList.contains('reveal-mask') || c.classList.contains('reveal-line') || c.classList.contains('reveal-rise')
          );
          const i = siblings.indexOf(target);
          target.style.animationDelay = `${Math.min(Math.max(i, 0), 5) * 80}ms`;
          observer.observe(target);
        });
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Count-up for stat numbers.
      const counters = document.querySelectorAll<HTMLElement>('[data-counter-target]');
      if (counters.length) {
        const animateCounter = (el: HTMLElement) => {
          const target = Number(el.dataset.counterTarget || '0');
          const suffix = el.dataset.counterSuffix ?? '';
          const prefix = el.dataset.counterPrefix ?? '';
          const useLocale = el.dataset.counterLocale === 'true';
          if (reduceMotion || !target) {
            el.textContent = `${prefix}${useLocale ? target.toLocaleString('pt-BR') : target}${suffix}`;
            return;
          }
          const duration = 1400;
          const start = performance.now();
          const easeOutExpo = (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t));
          const step = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            const value = Math.round(target * easeOutExpo(progress));
            el.textContent = `${prefix}${useLocale ? value.toLocaleString('pt-BR') : value}${suffix}`;
            if (progress < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };

        if ('IntersectionObserver' in window) {
          const counterObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  animateCounter(entry.target as HTMLElement);
                  counterObserver.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.4 }
          );
          counters.forEach((el) => counterObserver.observe(el));
        } else {
          counters.forEach((el) => animateCounter(el));
        }
      }

      // Accessible accordion: animates open/close via grid-template-rows instead of the
      // instant native <details> toggle, while keeping button + aria semantics.
      document.querySelectorAll<HTMLElement>('[data-accordion-item]').forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-accordion-trigger]');
        const panel = item.querySelector<HTMLElement>('[data-accordion-panel]');
        if (!trigger || !panel) return;
        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          document.querySelectorAll<HTMLElement>('[data-accordion-item]').forEach((other) => {
            if (other !== item) {
              other.querySelector('[data-accordion-trigger]')?.setAttribute('aria-expanded', 'false');
              other.querySelector<HTMLElement>('[data-accordion-panel]')?.style.setProperty('grid-template-rows', '0fr');
              other.classList.remove('is-open');
            }
          });
          trigger.setAttribute('aria-expanded', String(!isOpen));
          panel.style.setProperty('grid-template-rows', isOpen ? '0fr' : '1fr');
          item.classList.toggle('is-open', !isOpen);
        });
      });
    </script>

    <script>
      // dataLayer events for WhatsApp/tel clicks — GTM-WTKBQTWX is wired up above, so these
      // pushes are already visible to it. Hooking up Google Ads/GA4 conversions on top of
      // these events is a GTM config change (tags/triggers), not a code change.
      declare global {
        interface Window {
          dataLayer: any[];
        }
      }
      window.dataLayer = window.dataLayer || [];

      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';

        // Fixed-position elements (like the floating WhatsApp button) live outside any
        // <section>/<header>/<footer>, so they'd otherwise report 'unknown'. A link can opt in
        // to an explicit location via data-tracking-location instead of relying on its ancestor.
        const location = link.dataset.trackingLocation || link.closest('section, header, footer')?.id || 'unknown';

        if (href.includes('wa.me') || href.includes('api.whatsapp.com')) {
          window.dataLayer.push({
            event: 'whatsapp_click',
            link_url: href,
            link_text: link.textContent?.trim().slice(0, 100),
            link_location: location,
          });
        } else if (href.startsWith('tel:')) {
          window.dataLayer.push({
            event: 'phone_click',
            link_url: href,
            link_location: location,
          });
        }
      });
    </script>

    <script define:vars={{ LEADS_ENDPOINT, LEADS_SECRET }}>
      // Rastreio de leads (ver docs/leads-tracking.md): captura os parâmetros que o Google Ads
      // anexa na URL (sufixo de URL final da campanha) e guarda em sessionStorage, pra
      // sobreviver até o visitante preencher o formulário ou clicar no WhatsApp — mesmo que
      // isso aconteça em outra página do site, não só na de entrada.
      (function () {
        var params = new URLSearchParams(window.location.search);
        var keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'matchtype', 'gclid', 'device'];
        var hasAny = keys.some(function (k) { return params.has(k); });
        if (!hasAny) return;
        var data = {};
        keys.forEach(function (k) {
          if (params.has(k)) data[k] = params.get(k);
        });
        try {
          sessionStorage.setItem('bravoloc_lead_source', JSON.stringify(data));
        } catch (e) {
          /* sessionStorage indisponível (modo privado, etc.) — segue sem rastreio de origem */
        }
      })();

      // Função compartilhada usada pelo formulário de orçamento e pelo botão flutuante de
      // WhatsApp pra mandar cada lead (nome/whatsapp quando existir, + a origem capturada
      // acima) pro backend de planilha. Fire-and-forget: nunca atrasa nem bloqueia o
      // redirecionamento pro WhatsApp, mesmo se o envio falhar.
      window.sendBravoLocLead = function (extra) {
        if (!LEADS_ENDPOINT) return;
        var stored = {};
        try {
          stored = JSON.parse(sessionStorage.getItem('bravoloc_lead_source') || '{}');
        } catch (e) {
          /* ignora */
        }
        var origem = stored.utm_source
          ? stored.utm_source + '/' + (stored.utm_medium || '')
          : (document.referrer || 'direto');
        var payload = Object.assign(
          {
            secret: LEADS_SECRET,
            keyword: stored.utm_term || '',
            campanha: stored.utm_campaign || '',
            matchtype: stored.matchtype || '',
            dispositivo: stored.device || '',
            gclid: stored.gclid || '',
            origem: origem,
            pagina: window.location.href,
          },
          extra || {}
        );
        try {
          fetch(LEADS_ENDPOINT, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify(payload),
          }).catch(function () {
            /* falha de rede não deve impedir o lead de seguir pro WhatsApp */
          });
        } catch (e) {
          /* ignora */
        }
      };
    </script>
  </body>
</html>
