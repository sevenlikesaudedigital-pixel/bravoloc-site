---
import Layout from '../layouts/Layout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import ProdutosOverview from '../components/sections/ProdutosOverview.astro';
import Segmentos from '../components/sections/Segmentos.astro';
import Diferenciais from '../components/sections/Diferenciais.astro';
import Divider from '../components/sections/Divider.astro';
import ProvaSocial from '../components/sections/ProvaSocial.astro';
import Galeria from '../components/sections/Galeria.astro';
import QuoteForm from '../components/sections/QuoteForm.astro';
import CrossSell from '../components/sections/CrossSell.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTAFinal from '../components/sections/CTAFinal.astro';
import Localizacao from '../components/sections/Localizacao.astro';
import Footer from '../components/sections/Footer.astro';
import FloatingWhatsApp from '../components/sections/FloatingWhatsApp.astro';
---

<Layout
  title="Locação de Tenda em Fortaleza e Caucaia | Tenda Piramidal para Eventos e Obras — BravoLoc"
  description="Aluguel e venda de tenda piramidal em Fortaleza, Caucaia e região metropolitana. Tendas para evento, obra e construção civil, direto de quem fabrica — até 24% mais barato, com garantia de 2 anos e pronta entrega."
>
  <Header />
  <main>
    <Hero />
    <Galeria />
    <ProdutosOverview />
    <TrustStrip />
    <Segmentos />
    <Diferenciais />
    <Divider />
    <ProvaSocial />
    <QuoteForm />
    <CrossSell />
    <FAQ />
    <CTAFinal />
    <Localizacao />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>
