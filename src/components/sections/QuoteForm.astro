---
import { Image } from 'astro:assets';
import vendaLocacaoImg from '../../assets/images/venda-locacao-painel.png';

const WHATSAPP_NUMBER = '5585986560309';
---

<section id="orcamento" class="py-16 sm:py-24 bg-charcoal-950">
  <div class="mx-auto max-w-5xl px-5 sm:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
    <!-- Side panel: real BravoLoc artwork supplied by the client, used as-is. -->
    <div class="reveal-rise order-2 lg:order-1 rounded-2xl bg-sand-50 p-2 sm:p-3">
      <Image
        src={vendaLocacaoImg}
        alt="Venda ou locação, temos a solução ideal para o seu evento ou negócio — em todo o Ceará e no Brasil."
        widths={[500, 900]}
        width={900}
        sizes="(min-width: 1024px) 44vw, 92vw"
        class="w-full h-auto"
      />
    </div>

    <div class="order-1 lg:order-2">
      <div class="reveal-line">
        <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-ember-400">
          <span class="reveal-line-bar block h-0.5 w-8 bg-ember-500"></span>
          Orçamento
        </p>
        <h2 class="mt-3 font-display text-3xl sm:text-4xl text-sand-50 leading-tight">
          Fale Agora e Solicite Seu Orçamento
        </h2>
      </div>

      <form id="quote-form" class="reveal-rise mt-8 grid gap-4" style="animation-delay: 120ms" novalidate>
        <div>
          <label for="qf-nome" class="block text-sm font-semibold text-sand-50 mb-1.5">Nome</label>
          <input id="qf-nome" name="nome" type="text" required
            class="w-full rounded-md border border-charcoal-700 bg-charcoal-900 px-4 py-3 text-sand-50 placeholder:text-charcoal-500 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30"
            placeholder="Como podemos te chamar" />
        </div>

        <div>
          <label for="qf-whatsapp" class="block text-sm font-semibold text-sand-50 mb-1.5">WhatsApp</label>
          <input id="qf-whatsapp" name="whatsapp" type="tel" required
            class="w-full rounded-md border border-charcoal-700 bg-charcoal-900 px-4 py-3 text-sand-50 placeholder:text-charcoal-500 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30"
            placeholder="(85) 99999-9999" />
        </div>

        <div>
          <label for="qf-email" class="block text-sm font-semibold text-sand-50 mb-1.5">E-mail</label>
          <input id="qf-email" name="email" type="email" required
            class="w-full rounded-md border border-charcoal-700 bg-charcoal-900 px-4 py-3 text-sand-50 placeholder:text-charcoal-500 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30"
            placeholder="seuemail@exemplo.com" />
        </div>

        <p id="qf-error" class="hidden text-sm text-flame-500" role="alert">
          Preenche nome, WhatsApp e e-mail pra gente conseguir te atender direito.
        </p>

        <button
          type="submit"
          class="shade-sweep inline-flex items-center justify-center gap-2 rounded-md bg-ember-500 px-6 py-4 text-base font-bold text-charcoal-900 hover:bg-ember-400 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.02.24-3.4-.7-2.88-1.14-4.72-4.06-4.86-4.25-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.1 1-2.38.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.83 2 .9 2.14.07.15.12.31.02.5-.1.19-.15.3-.3.47-.15.16-.31.36-.44.48-.15.14-.3.3-.13.58.17.29.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.35 1.46.29.14.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.14.26.1 1.65.78 1.94.92.29.14.48.22.55.34.07.12.07.68-.17 1.36z"/>
          </svg>
          Solicitar Orçamento
        </button>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ WHATSAPP_NUMBER }}>
  const form = document.getElementById('quote-form');
  const errorEl = document.getElementById('qf-error');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nome = (data.get('nome') || '').toString().trim();
    const whatsapp = (data.get('whatsapp') || '').toString().trim();
    const email = (data.get('email') || '').toString().trim();

    if (!nome || !whatsapp || !email) {
      errorEl?.classList.remove('hidden');
      return;
    }
    errorEl?.classList.add('hidden');

    const message = encodeURIComponent(
      `Olá! Meu nome é ${nome} e quero um orçamento na BravoLoc. Meu WhatsApp: ${whatsapp}. Meu e-mail: ${email}`
    );

    // This form opens wa.me via window.open() rather than a real <a> click, so it's invisible
    // to Layout.astro's generic link-click listener — push its own event so it's not a blind
    // spot for GTM/GA4/Ads conversion tracking.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'generate_lead',
      form_id: 'quote-form',
      form_location: 'orcamento',
    });

    // Grava o lead (nome, whatsapp, palavra-chave/gclid capturados na chegada) na planilha de
    // rastreio — ver Layout.astro. Fire-and-forget, não atrasa o redirecionamento abaixo.
    window.sendBravoLocLead?.({ nome: nome, whatsapp: whatsapp, formulario: 'quote-form' });

    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`, '_blank', 'noopener');
  });
</script>
