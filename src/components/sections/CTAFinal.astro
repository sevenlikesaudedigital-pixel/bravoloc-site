---
// Fold 10. Background swapped from flat ember to a real installation photo (dunes/lagoon),
// per request — logo centered over it, headline rewritten (not copied) from a reference phrase,
// grounded in real coverage (Ceará locação + Brasil venda), no invented tenure claim.
import { Image, getImage } from 'astro:assets';
import bgSource from '../../assets/images/galeria-02-duna.jpg';
import logo from '../../assets/images/logo-bravoloc-horizontal.png';

const bg = await getImage({ src: bgSource, width: 1600, quality: 72, format: 'jpg' });
---

<section class="relative overflow-hidden py-20 sm:py-28" style={`background-image: url(${bg.src}); background-size: cover; background-position: center;`}>
  <div class="absolute inset-0 bg-charcoal-950/75"></div>

  <div class="relative mx-auto max-w-3xl px-5 sm:px-8 text-center">
    <Image src={logo} alt="BravoLoc" width={888} height={436} class="reveal-rise mx-auto h-14 sm:h-16 w-auto" />

    <h2 class="reveal-mask mt-7">
      <span class="reveal-mask-clip font-display text-2xl sm:text-4xl text-sand-50 leading-tight block" style="animation-delay: 60ms">
        Obras, eventos e negócios que não podem parar — cobertos em todo o Ceará, com venda pra o Brasil inteiro.
      </span>
    </h2>

    <a
      href="#orcamento"
      class="shade-sweep reveal mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-ember-500 px-7 py-4 text-base font-bold text-charcoal-900 hover:bg-ember-400 transition-colors"
      style="animation-delay: 140ms"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.02.24-3.4-.7-2.88-1.14-4.72-4.06-4.86-4.25-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.1 1-2.38.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.83 2 .9 2.14.07.15.12.31.02.5-.1.19-.15.3-.3.47-.15.16-.31.36-.44.48-.15.14-.3.3-.13.58.17.29.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.35 1.46.29.14.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.14.26.1 1.65.78 1.94.92.29.14.48.22.55.34.07.12.07.68-.17 1.36z"/>
      </svg>
      Quero Meu Orçamento
    </a>
  </div>
</section>
