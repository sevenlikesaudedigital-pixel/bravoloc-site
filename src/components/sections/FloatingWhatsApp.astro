---
const WHATSAPP_NUMBER = '5585986560309';
---

<button
  id="fab-whatsapp"
  type="button"
  aria-haspopup="dialog"
  aria-controls="fab-whatsapp-modal"
  class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-charcoal-950/40 hover:bg-[#20BD5A] transition-colors"
  aria-label="Falar no WhatsApp"
>
  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.02.24-3.4-.7-2.88-1.14-4.72-4.06-4.86-4.25-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.1 1-2.38.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.83 2 .9 2.14.07.15.12.31.02.5-.1.19-.15.3-.3.47-.15.16-.31.36-.44.48-.15.14-.3.3-.13.58.17.29.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.35 1.46.29.14.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.14.26.1 1.65.78 1.94.92.29.14.48.22.55.34.07.12.07.68-.17 1.36z"/>
  </svg>
</button>

<div
  id="fab-whatsapp-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="fab-whatsapp-title"
  class="hidden fixed inset-0 z-50 items-center justify-center p-5"
>
  <div id="fab-whatsapp-backdrop" class="absolute inset-0 bg-charcoal-950/70 backdrop-blur-sm"></div>

  <div class="relative w-full max-w-sm rounded-2xl bg-sand-50 p-6 shadow-2xl">
    <button
      id="fab-whatsapp-close"
      type="button"
      aria-label="Fechar"
      class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full text-charcoal-500 hover:bg-sand-200 hover:text-charcoal-900 transition-colors"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <h3 id="fab-whatsapp-title" class="font-display text-xl text-charcoal-900">Falar no WhatsApp</h3>

    <form id="fab-whatsapp-form" class="mt-5 grid gap-3" novalidate>
      <div>
        <label for="fab-nome" class="block text-sm font-semibold text-charcoal-800 mb-1.5">Nome</label>
        <input id="fab-nome" name="nome" type="text" required
          class="w-full rounded-md border border-charcoal-300 bg-sand-50 px-4 py-2.5 text-charcoal-900 placeholder:text-charcoal-400 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30"
          placeholder="Como podemos te chamar" />
      </div>
      <div>
        <label for="fab-whatsapp-input" class="block text-sm font-semibold text-charcoal-800 mb-1.5">WhatsApp</label>
        <input id="fab-whatsapp-input" name="whatsapp" type="tel" required
          class="w-full rounded-md border border-charcoal-300 bg-sand-50 px-4 py-2.5 text-charcoal-900 placeholder:text-charcoal-400 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30"
          placeholder="(85) 99999-9999" />
      </div>

      <p id="fab-whatsapp-error" class="hidden text-sm text-flame-600" role="alert">
        Preenche nome e WhatsApp pra continuar.
      </p>

      <button
        type="submit"
        class="mt-1 inline-flex items-center justify-center gap-2 rounded-md bg-ember-500 px-5 py-3 text-sm font-bold text-charcoal-900 hover:bg-ember-400 transition-colors"
      >
        Continuar no WhatsApp
      </button>

      <p class="text-center text-xs text-charcoal-500">
        Após preenchimento você será encaminhado automaticamente para o WhatsApp.
      </p>
    </form>
  </div>
</div>

<script define:vars={{ WHATSAPP_NUMBER }}>
  const trigger = document.getElementById('fab-whatsapp');
  const modal = document.getElementById('fab-whatsapp-modal');
  const backdrop = document.getElementById('fab-whatsapp-backdrop');
  const closeBtn = document.getElementById('fab-whatsapp-close');
  const form = document.getElementById('fab-whatsapp-form');
  const errorEl = document.getElementById('fab-whatsapp-error');

  const openModal = () => {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.getElementById('fab-nome')?.focus();
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
    trigger?.focus();
  };

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) closeModal();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nome = (data.get('nome') || '').toString().trim();
    const whatsapp = (data.get('whatsapp') || '').toString().trim();

    if (!nome || !whatsapp) {
      errorEl?.classList.remove('hidden');
      return;
    }
    errorEl?.classList.add('hidden');

    const message = encodeURIComponent(
      `Olá! Meu nome é ${nome} e quero um orçamento na BravoLoc. Meu WhatsApp: ${whatsapp}`
    );

    // Same as QuoteForm.astro: window.open() bypasses the generic <a> click listener in
    // Layout.astro, so this conversion needs its own dataLayer push to be visible to GTM.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'generate_lead',
      form_id: 'fab-whatsapp-form',
      form_location: 'floating_whatsapp',
    });

    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${message}`, '_blank', 'noopener');
    closeModal();
    form.reset();
  });
</script>
