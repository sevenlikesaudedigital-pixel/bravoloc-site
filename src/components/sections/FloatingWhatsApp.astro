---
const WHATSAPP_NUMBER = '5585986560309';

const WHATSAPP_ICON =
  'M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.02.24-3.4-.7-2.88-1.14-4.72-4.06-4.86-4.25-.14-.19-1.17-1.55-1.17-2.96 0-1.4.74-2.1 1-2.38.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.83 2 .9 2.14.07.15.12.31.02.5-.1.19-.15.3-.3.47-.15.16-.31.36-.44.48-.15.14-.3.3-.13.58.17.29.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.35 1.46.29.14.46.12.63-.07.17-.19.72-.84.92-1.13.19-.29.38-.24.64-.14.26.1 1.65.78 1.94.92.29.14.48.22.55.34.07.12.07.68-.17 1.36z';
---

<!--
  Botão flutuante do WhatsApp com popup: pede nome, WhatsApp e se quer comprar ou alugar antes
  de encaminhar pro WhatsApp (mesmo padrão do site da GS3). Como agora é <button> e não um link
  wa.me, o listener genérico de <a> do Layout.astro não enxerga o clique — então o evento
  'whatsapp_click' do GTM é disparado aqui, só depois do preenchimento (intenção real).
-->
<button
  id="floating-whatsapp-link"
  type="button"
  aria-haspopup="dialog"
  aria-label="Falar no WhatsApp"
  class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-charcoal-950/40 hover:bg-[#20BD5A] transition-colors"
>
  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={WHATSAPP_ICON}></path>
  </svg>
</button>

<div
  id="whatsapp-modal-backdrop"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-charcoal-950/70 p-5 backdrop-blur-sm"
>
  <div
    id="whatsapp-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="whatsapp-modal-title"
    class="w-full max-w-sm rounded-2xl bg-charcoal-900 p-6 shadow-xl border border-charcoal-700"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="whatsapp-modal-title" class="font-display text-xl text-sand-50">Falar no WhatsApp</h2>
        <p class="mt-1 text-sm text-charcoal-300">
          Ao deixar seu nome e WhatsApp você será encaminhado automaticamente para a conversa.
        </p>
      </div>
      <button
        type="button"
        id="whatsapp-modal-close"
        aria-label="Fechar"
        class="shrink-0 rounded-full p-1 text-charcoal-400 transition-colors hover:bg-charcoal-800 hover:text-sand-50"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <form id="whatsapp-modal-form" class="mt-5 grid gap-4" novalidate>
      <div>
        <label for="wa-nome" class="block text-sm font-semibold text-sand-50 mb-1.5">Nome</label>
        <input id="wa-nome" name="nome" type="text" required autocomplete="name" placeholder="Como podemos te chamar"
          class="w-full rounded-md border border-charcoal-700 bg-charcoal-950 px-4 py-3 text-sand-50 placeholder:text-charcoal-500 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30" />
      </div>

      <div>
        <label for="wa-whatsapp" class="block text-sm font-semibold text-sand-50 mb-1.5">WhatsApp</label>
        <input id="wa-whatsapp" name="whatsapp" type="tel" required autocomplete="tel" placeholder="(85) 99999-9999"
          class="w-full rounded-md border border-charcoal-700 bg-charcoal-950 px-4 py-3 text-sand-50 placeholder:text-charcoal-500 focus:border-ember-500 focus:outline-none focus:ring-2 focus:ring-ember-500/30" />
      </div>

      <fieldset>
        <legend class="block text-sm font-semibold text-sand-50 mb-1.5">Você quer</legend>
        <div class="grid grid-cols-2 gap-3">
          <label class="cursor-pointer">
            <input type="radio" name="interesse" value="Comprar" required class="peer sr-only" />
            <div class="rounded-md border border-charcoal-700 bg-charcoal-950 px-4 py-3 text-center font-semibold text-sand-50 transition-colors peer-checked:border-ember-500 peer-checked:bg-ember-500 peer-checked:text-charcoal-900 peer-focus-visible:ring-2 peer-focus-visible:ring-ember-500/40">Comprar</div>
          </label>
          <label class="cursor-pointer">
            <input type="radio" name="interesse" value="Alugar" class="peer sr-only" />
            <div class="rounded-md border border-charcoal-700 bg-charcoal-950 px-4 py-3 text-center font-semibold text-sand-50 transition-colors peer-checked:border-ember-500 peer-checked:bg-ember-500 peer-checked:text-charcoal-900 peer-focus-visible:ring-2 peer-focus-visible:ring-ember-500/40">Alugar</div>
          </label>
        </div>
      </fieldset>

      <p id="whatsapp-modal-error" class="hidden text-sm text-flame-500" role="alert">
        Preencha nome, WhatsApp e se quer comprar ou alugar para continuar.
      </p>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-md bg-[#25D366] px-6 py-4 text-base font-bold text-white hover:bg-[#20BD5A] transition-colors"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={WHATSAPP_ICON}></path>
        </svg>
        Continuar no WhatsApp
      </button>
    </form>
  </div>
</div>

<script define:vars={{ WHATSAPP_NUMBER }}>
  const fab = document.getElementById('floating-whatsapp-link');
  const backdrop = document.getElementById('whatsapp-modal-backdrop');
  const closeBtn = document.getElementById('whatsapp-modal-close');
  const form = document.getElementById('whatsapp-modal-form');
  const errorEl = document.getElementById('whatsapp-modal-error');
  const nomeInput = document.getElementById('wa-nome');

  const openModal = () => {
    backdrop?.classList.remove('hidden');
    backdrop?.classList.add('flex');
    nomeInput?.focus();
  };

  const closeModal = () => {
    backdrop?.classList.add('hidden');
    backdrop?.classList.remove('flex');
  };

  fab?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nome = String(data.get('nome') || '').trim();
    const whatsapp = String(data.get('whatsapp') || '').trim();
    const interesse = String(data.get('interesse') || '').trim();

    if (!nome || !whatsapp || !interesse) {
      errorEl?.classList.remove('hidden');
      return;
    }
    errorEl?.classList.add('hidden');

    // Mesmo evento/local que o link antigo disparava, pra não mexer no GTM/conversão do Ads.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'whatsapp_click',
      link_location: 'floating_whatsapp',
      interesse,
    });

    // Linha na planilha de leads (ver Layout.astro), agora com nome, WhatsApp e Comprar/Alugar.
    window.sendBravoLocLead?.({ nome, whatsapp, interesse, formulario: 'floating_whatsapp' });

    const acao = interesse === 'Alugar' ? 'alugar' : 'comprar';
    const text = `Olá, estou vindo do site da BravoLoc. Meu nome é ${nome} e gostaria de um orçamento para ${acao} uma tenda. Meu WhatsApp: ${whatsapp}`;
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');

    closeModal();
    form.reset();
  });
</script>
