---
// Fold 6. Rating and testimonial quotes are real, pulled from the live Google Business Profile
// (confirmed by the owner via screenshot: 5,0 · 17 avaliações). Reviewer names/dates aren't
// available from the public panel, so cards are labeled "Avaliação verificada no Google"
// instead of inventing a name or a "há X meses" timestamp.
const depoimentos = [
  '"Acabamento top e entregou antes do prazo, estão de parabéns"',
  '"Ótimo atendimento, preço justo e serviço excelente."',
  '"Agradecemos pela parceria e profissionalismo!"',
];
---

<section id="avaliacoes" class="py-16 sm:py-24 bg-charcoal-950">
  <div class="mx-auto max-w-2xl px-5 sm:px-8 text-center">
    <div class="reveal inline-flex items-center gap-2 rounded-full bg-charcoal-900 border border-charcoal-800 px-4 py-1.5">
      <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.67-.22-2.45H12v4.64h6.46a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.09 3.58-5.17 3.58-8.81Z"/>
        <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.92l-3.88-3c-1.08.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.94H1.28v3.1A12 12 0 0 0 12 24Z"/>
        <path fill="#FBBC05" d="M5.29 14.29a7.2 7.2 0 0 1 0-4.58v-3.1H1.28a12 12 0 0 0 0 10.78l4.01-3.1Z"/>
        <path fill="#EA4335" d="M12 4.75c1.76 0 3.35.6 4.6 1.79l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.28 6.61l4.01 3.1C6.23 6.86 8.88 4.75 12 4.75Z"/>
      </svg>
      <span class="text-xs font-bold uppercase tracking-wide text-sand-200">Google Meu Negócio</span>
    </div>

    <h2 class="reveal-mask mt-5">
      <span class="reveal-mask-clip font-display text-3xl sm:text-4xl text-sand-50 block" style="animation-delay: 60ms">
        O Que Nossos Clientes Dizem
      </span>
    </h2>

    <div class="reveal mt-4 flex items-center justify-center gap-2" style="animation-delay: 100ms">
      <span class="text-ember-500 tracking-tight" aria-hidden="true">★★★★★</span>
      <span class="font-mono text-lg font-bold text-sand-50">5,0</span>
      <span class="text-sm text-charcoal-400">· 17 avaliações no Google</span>
    </div>
  </div>

  <div class="reveal-rise relative mt-10 max-w-lg mx-auto px-5 sm:px-0" style="animation-delay: 140ms">
    <div id="prova-track" class="relative overflow-hidden rounded-2xl">
      {depoimentos.map((quote, i) => (
        <div
          data-prova-slide
          class:list={["rounded-2xl bg-sand-50 px-6 py-8 sm:px-8 sm:py-9", i !== 0 && "hidden"]}
        >
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ember-500 text-charcoal-900 font-bold">G</span>
              <div>
                <p class="text-sm font-bold text-charcoal-900">Avaliação verificada</p>
                <p class="text-xs text-charcoal-500">no Google</p>
              </div>
            </div>
            <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.67-.22-2.45H12v4.64h6.46a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.09 3.58-5.17 3.58-8.81Z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.92l-3.88-3c-1.08.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.94H1.28v3.1A12 12 0 0 0 12 24Z"/>
              <path fill="#FBBC05" d="M5.29 14.29a7.2 7.2 0 0 1 0-4.58v-3.1H1.28a12 12 0 0 0 0 10.78l4.01-3.1Z"/>
              <path fill="#EA4335" d="M12 4.75c1.76 0 3.35.6 4.6 1.79l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.28 6.61l4.01 3.1C6.23 6.86 8.88 4.75 12 4.75Z"/>
            </svg>
          </div>
          <p class="mt-4 text-ember-500 text-sm tracking-tight" aria-hidden="true">★★★★★</p>
          <p class="mt-3 text-charcoal-800 leading-relaxed">{quote}</p>
        </div>
      ))}
    </div>

    <div class="mt-5 flex items-center justify-center gap-2">
      {depoimentos.map((_, i) => (
        <button
          type="button"
          data-prova-dot={i}
          aria-label={`Ver depoimento ${i + 1}`}
          class:list={["h-2 rounded-full transition-all duration-300", i === 0 ? "w-6 bg-ember-500" : "w-2 bg-charcoal-700"]}
        />
      ))}
    </div>
  </div>

</section>

<script>
  const slides = document.querySelectorAll<HTMLElement>('[data-prova-slide]');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-prova-dot]');
  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  const show = (index: number) => {
    current = (index + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle('hidden', i !== current));
    dots.forEach((d, i) => {
      d.classList.toggle('w-6', i === current);
      d.classList.toggle('bg-ember-500', i === current);
      d.classList.toggle('w-2', i !== current);
      d.classList.toggle('bg-charcoal-700', i !== current);
    });
  };

  dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); resetTimer(); }));

  const resetTimer = () => {
    if (timer) clearInterval(timer);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = setInterval(() => show(current + 1), 4500);
    }
  };

  if (slides.length > 1) resetTimer();
</script>
