---
const pains = [
  {
    title: 'Fornecedor atrasou e a obra ou o evento pagou o preço',
    desc: 'Prazo estourado gera multa, cliente insatisfeito e a culpa cai em cima de quem contratou — não de quem entregou tarde.',
  },
  {
    title: 'Material chegou diferente do combinado',
    desc: 'Estrutura fraca que não aguenta vento forte, lona velha, peça faltando na hora da montagem.',
  },
  {
    title: 'Precisou de estoque rápido e não achou fornecedor confiável fora da região',
    desc: 'Comprar de fora do estado parece arriscado sem ver o produto antes — e o frete pode comer a vantagem do preço.',
  },
  {
    title: 'Pagou adiantado e ficou na mão',
    desc: 'Sem garantia de prazo, sem suporte se algo vier com defeito, sem ninguém pra responder rápido.',
  },
];
---

<section class="py-16 sm:py-24 bg-sand-100">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal-line max-w-2xl">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-ember-700">
        <span class="reveal-line-bar block h-0.5 w-8 bg-ember-500"></span>
        O problema
      </p>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl text-charcoal-900 leading-tight">
        Cobertura não pode ser o detalhe que quebra o cronograma
      </h2>
    </div>

    <div class="mt-10 grid sm:grid-cols-2 gap-4 sm:gap-5">
      {pains.map((pain, i) => (
        <div
          class="reveal-rise rounded-xl bg-sand-50 border border-charcoal-900/10 p-6"
          style={`animation-delay: ${i * 90}ms`}
        >
          <p class="font-mono text-sm text-ember-600 font-bold">0{i + 1}</p>
          <h3 class="mt-2 text-lg font-bold text-charcoal-900 leading-snug">{pain.title}</h3>
          <p class="mt-2 text-sm text-charcoal-600 leading-relaxed">{pain.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
